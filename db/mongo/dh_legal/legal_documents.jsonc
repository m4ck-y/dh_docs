{
  // Base: MongoDB `dh_legal` · colección `legal_documents` (propuesta — ADR 050).
  // La EVIDENCIA del texto legal versionado. El texto NO está acá: es un archivo.

  "_id": "6710a1b2c3d4e5f60718293a",          // auto — ObjectId
  "key": "TERMS",                             // TERMS | PRIVACY  (ELegalDocKey)
  "version": "2026-10",                       // nombre lógico de la versión — YYYY-MM

  "url": "s3://dh-legal/legal/terms/2026-10.md",  // archivo en object storage — INTERNO, nunca se expone
  "mime_type": "text/markdown",               // text/markdown | text/html  (convención del dominio storage)
  "hash": "sha256:9f2c4d…",                   // sha256 de los BYTES del archivo publicado — aquí ficticio
  "size_bytes": 8123,                         // tamaño del archivo publicado

  "status": "PUBLISHED",                      // DRAFT | PUBLISHED | RETIRED  (ELegalDocStatus)
  "effective_from": "2026-10-01T00:00:00Z",   // UTC — desde cuándo rige
  "retired_at": null,                         // UTC — se llena al retirar; null si vigente
  "created_by": "3f7a1c2e-8b45-4d19-9a67-1e2f3a4b5c6d"  // uuid de quien publica (auditoría)

  // El archivo y el documento son inmutables: un cambio = versión NUEVA (candado: índice único `key` + `version`).
  // Versión VIGENTE = la `PUBLISHED` con mayor `effective_from`. La ruta publicada nunca se sobrescribe.
  // `version` + `hash` son el vínculo LÓGICO con `legal_acceptances` (no una FK).
  // El bucket es privado: la API lee `url` y sirve el contenido (el cliente nunca ve la url).
}
