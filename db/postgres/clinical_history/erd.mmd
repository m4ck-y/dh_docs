erDiagram
    %% CLINICAL_HISTORY SCHEMA
    %% Historial clinico con trazabilidad temporal.
    %%   condition: condiciones/enfermedades de la persona (CIE-11).
    %%   medication_statement: medicamentos de la persona (reportados; FHIR MedicationStatement).
    %%   medication_condition: puente N:N (medicamento <-> condicion; FHIR reason).
    %% Contrato del componente: docs/features/clinical_history/contracts/medication_statement.md
    %% PENDIENTE de diseno: encounter (consultas) + encounter_diagnosis (puente).

    %% REFERENCIAS EXTERNAS
    %% person: definida en schema people
    %% catalogs.medication: catalogo (ClickHouse) -> referencia SUAVE (sin FK, cross-engine)

    %% RELACIONES
    person ||--o{ condition : "has_conditions"
    person ||--o{ medication_statement : "takes"
    medication_statement ||--o{ medication_condition : "reason"
    condition ||--o{ medication_condition : "reason"

    %% ENUMS
    EConditionCategory {
        String PROBLEM_LIST "PROBLEM_LIST"
        String ENCOUNTER_DIAGNOSIS "ENCOUNTER_DIAGNOSIS"
    }
    EConditionClinicalStatus {
        String ACTIVE "ACTIVE"
        String RECURRENCE "RECURRENCE"
        String RELAPSE "RELAPSE"
        String INACTIVE "INACTIVE"
        String REMISSION "REMISSION"
        String RESOLVED "RESOLVED"
    }
    EConditionSeverity {
        String MILD "MILD"
        String MODERATE "MODERATE"
        String SEVERE "SEVERE"
    }
    EMedicationStatementStatus {
        String ACTIVE "ACTIVE"
        String COMPLETED "COMPLETED"
        String STOPPED "STOPPED"
        String ON_HOLD "ON_HOLD"
    }
    EMedicationAdherence {
        String ALWAYS "ALWAYS"
        String SOMETIMES "SOMETIMES"
        String NEVER "NEVER"
        String UNKNOWN "UNKNOWN"
    }
    EInformationSource {
        String PATIENT "PATIENT"
        String RELATIVE "RELATIVE"
        String CLINICIAN "CLINICIAN"
    }

    %% ENTIDADES
    %% condition: enfermedad/condicion (unifica chronic_condition + diagnosis_record)
    %% id_person: persona que la padece (paciente o pariente)
    %% cie11_code: codigo CIE-11 (catalogo disease); name = fallback / "Otro"
    %% category: PROBLEM_LIST (lista de problemas) | ENCOUNTER_DIAGNOSIS (diagnostico de consulta)
    %% contributed_to_death: la condicion contribuyo a la muerte (FHIR)
    condition {
        Integer id PK
        UUID uuid
        Integer id_person FK
        String cie11_code
        Text name
        Enum(EConditionCategory) category
        Enum(EConditionClinicalStatus) clinical_status
        Enum(EConditionSeverity) severity
        Date onset_date
        Boolean contributed_to_death
        Text notes
    }

    %% medication_statement: medicamento de la persona (reportado; FHIR MedicationStatement)
    %% id_person: quien lo toma
    %% medication_code_system + medication_code: CodeableConcept -> item del catalogo
    %%   medication (Vademecum); referencia SUAVE (catalogo en ClickHouse, sin FK)
    %% name: display / fallback
    %% dosage: JSONB (Dosage[] de FHIR)
    %% instructions: texto libre (renderedDosageInstruction)
    %% status: ACTIVE | COMPLETED | STOPPED | ON_HOLD (desviacion intencional de FHIR R5)
    %% start_date/end_date: periodo (effective[x] -> Period; end_date null = vigente)
    %% date_asserted: cuando se reporto
    %% adherence_code: ALWAYS | SOMETIMES | NEVER | UNKNOWN
    %% information_source: quien lo reporto (paciente/pariente/clinico)
    medication_statement {
        Integer id PK
        UUID uuid
        Integer id_person FK
        String medication_code_system
        String medication_code
        Text name
        Jsonb dosage
        Text instructions
        Enum(EMedicationStatementStatus) status
        Date start_date
        Date end_date
        Timestamp date_asserted
        Enum(EMedicationAdherence) adherence_code
        Enum(EInformationSource) information_source
        Text notes
    }

    %% medication_condition: puente N:N (motivo: para que condicion se toma)
    medication_condition {
        Integer id PK
        Integer id_medication_statement FK
        Integer id_condition FK
    }

    %% PENDIENTE DE DISENO (comentado)
    %% encounter: consultas/atenciones (Encounter)
    %% encounter_diagnosis: puente condicion <-> consulta (Encounter.diagnosis)
    %%   id_encounter FK, id_condition FK, use (EEncounterDiagnosisUse), rank (int)
    %%   Nota: no toda condicion tiene consulta (paciente / data perdida) -> puente opcional.
