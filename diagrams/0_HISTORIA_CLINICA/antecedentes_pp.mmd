%% Fuente: docs/diagrams/0_HISTORIA_CLINICA/0_DEMO_HISTORIA_CLINICA.drawio (tab "D - ANTECEDENTES PP")
%% Convención: flowchart estructural. ANTECEDENTES PERSONALES PATOLÓGICOS.
%% Nota del drawio: secciones "VIENE EN Q" (conexión desde cuestionario) y
%% "Agregar loop" (registro repetible de cirugías/lesiones/hospitalizaciones).

    d(["ANTECEDENTES PERSONALES PATOLÓGICOS"]) --> d2["2.0 ¿Padece o ha padecido alguna de las siguientes enfermedades alguna vez en tu vida?<br/>2.1 Diabetes, colesterol y metabolismo / 2.2 Presión alta y corazón / 2.3 Cerebro y sistema nervioso / 2.4 Emociones, aprendizaje y desarrollo / 2.5 Pulmones y respiración / 2.6 Visión y ojos / 2.7 Estómago, intestino y digestión / 2.8 Hígado, riñón y páncreas / 2.9 Huesos, músculos y articulaciones / 2.10 Piel, cabello y uñas / 2.11 Cáncer y tumores / 2.12 Enfermedades hereditarias y autoinmunes / 2.13 Enfermedades de la sangre y vasculares"]

    d2 --> d3["3.0 ¿Cómo describiría su consumo de tabaco?<br/>3.1 Fuma a diario → 3.1.1 ¿Cuántos cigarros fuma al día? / 3.2 Fuma ocasionalmente / 3.3 Ex fumador/a → 3.3.1 ¿Cuántos fumaba? · 3.3.2 ¿A qué edad empezó? · 3.3.3 ¿A qué edad dejó? / 3.4 Nunca ha fumado / 3.5 Prefiere no decirlo"]

    d3 --> d3a["3.0A ¿Alguien cercano a usted fuma?<br/>3.0A.1 Sí → 3.0A.1.1 ¿Dónde ocurre la exposición? (Hogar / Trabajo / Lugares sociales) · ¿Cuántas horas al día? · ¿Desde hace cuántos años? / 3.0A.2 No"]

    d3a --> d3b["3.0B ¿Usa o ha usado vapeadores?<br/>3.0B.1 Sí, los uso actualmente → 3.0B.1.1 ¿Qué sustancia usa? (Nicotina / Cannabis-THC / Sólo sabor) · 3.0B.1.2 ¿Cada cuánto? (A diario / Varias veces por semana / 1 vez por semana o menos / Rara vez) / 3.0B.2 Estoy intentando dejarlos / 3.0B.3 Los usaba antes / 3.0B.4 Nunca he usado"]

    d3b --> d4["4.0 ¿Consume bebidas alcohólicas?<br/>4.1 Sí / 4.2 No"]
    d4 --> d5["5.0 ¿Ha consumido algún tipo de droga?<br/>5.1 Sí → 5.1.1 ¿Cuál(es)? / 5.2 No"]
    d5 --> d6["6.0 ¿Padece algún tipo de alergia?<br/>6.1 Sí → 6.1.1 ¿A qué? (6.1.1.1 Medicamentos [Vademecum] / 6.1.1.2 Alimentos / 6.1.1.3 Ambiente / 6.1.1.4 Otro) / 6.2 No"]
    d6 --> d7["7.0 ¿Ha tenido alguna operación o cirugía?<br/>7.1 Sí → 7.1.2 Indique la fecha · 7.1.3 Agregar otra cirugía · 7.1.4 Finalizar registro / 7.2 No"]
    d7 --> d8["8.0 ¿Le han transfundido sangre?<br/>8.1 Sí → 8.1.1 Indique la fecha · 8.1.2 ¿Cuál fue el motivo? / 8.2 No"]
    d8 --> d9["9.0 ¿Ha donado sangre?<br/>9.1 Sí / 9.2 No"]
    d9 --> d10["10.0 ¿Ha sufrido alguna de las siguientes lesiones?<br/>10.1 Fractura → (10.1.1 ¿Qué huesos? · ¿El hueso quedó expuesto? (Sí/No) · 10.1.2 ¿Qué lado del cuerpo? (Derecho/Izquierdo/Ambos/No aplica) · 10.1.3 Fecha · 10.1.4 Secuelas) / 10.2 Luxación / 10.3 Esguince / 10.4 Ninguna"]
    d10 --> d10rep["10.1.5 ¿Desea registrar otra lesión?<br/>10.1.5.1 Sí, registrar / 10.1.5.2 No, terminar registro"]
    d10rep --> d11["11.0 ¿Ha estado hospitalizado alguna vez?<br/>11.1 Sí → 11.1.1 ¿Motivo? · 11.1.2 ¿Fecha de ingreso? · 11.1.3 ¿Duración? (11.1.4.1 1-7 días / 11.1.4.2 8-14 días / 11.1.4.3 15-30 días / 11.1.4.4 Más de 30) · 11.1.5 ¿Programada o urgencia? · 11.1.6 ¿De dónde fue trasladado? (Casa / Consulta externa / Otro hospital) / 11.2 No"]
    d11 --> d11rep["11.1.7 ¿Ha tenido otra hospitalización?<br/>11.1.7.1 Sí, registrar / 11.1.7.2 No, terminar registro"]
    d11rep --> df(["Fin APNP"])
