%% Convención: un nodo por ítem + opciones numeradas con valor.
%% CDI (Children's Depression Inventory): 27 ítems, 3 opciones (0-2).
%% Raridad del drawio anotada: el ítem 5 duplica la etiqueta "5.1" (la segunda
%% opción debería ser 5.2); el ítem 25 viene invertido respecto a la escala CDI
%% estándar (Nadie me quiere=0 ... Estoy seguro de que alguien me quiere=2).

    start(["Cuestionario CDI"]) --> intro["En las últimas dos semanas"]
    intro --> c1

    c1["1.<br/>1.1. Estoy triste de vez en cuando (0)<br/>1.2. Estoy triste muchas veces (1)<br/>1.3. Estoy triste siempre (2)"] --> c2
    c2["2.<br/>2.1. Las cosas me saldrán bien (0)<br/>2.2. No estoy seguro de si las cosas me saldrán bien (1)<br/>2.3. Nunca me saldrá nada bien (2)"] --> c3
    c3["3.<br/>3.1. Hago bien la mayoría de las cosas (0)<br/>3.2. Hago mal muchas cosas (1)<br/>3.3. Todo lo hago mal (2)"] --> c4
    c4["4.<br/>4.1. Me divierten muchas cosas (0)<br/>4.2. Me divierten algunas cosas (1)<br/>4.3. Nada me divierte (2)"] --> c5
    c5["5.<br/>5.1. Soy malo algunas veces (0)<br/>5.2. Soy malo muchas veces (1)<br/>5.3. Soy malo siempre (2)"] --> c6
    c6["6.<br/>6.1. A veces pienso que me pueden ocurrir cosas malas (0)<br/>6.2. Me preocupa que me ocurran cosas malas (1)<br/>6.3. Estoy seguro de que me van a ocurrir cosas terribles (2)"] --> c7
    c7["7.<br/>7.1. Me gusta como soy (0)<br/>7.2. No me gusta como soy (1)<br/>7.3. Me odio (2)"] --> c8
    c8["8.<br/>8.1. Generalmente no tengo la culpa de que ocurran cosas malas (0)<br/>8.2. Muchas cosas malas son culpa mía (1)<br/>8.3. Todas las cosas malas son culpa mía (2)"] --> c9
    c9["9.<br/>9.1. No pienso en matarme (0)<br/>9.2. Pienso en matarme pero no lo haría (1)<br/>9.3. Quiero matarme (2)"] --> c10
    c10["10.<br/>10.1. Tengo ganas de llorar de cuando en cuando (0)<br/>10.2. Tengo ganas de llorar muchos días (1)<br/>10.3. Tengo ganas de llorar todos los días (2)"] --> c11
    c11["11.<br/>11.1. Las cosas me preocupan de cuando en cuando (0)<br/>11.2. Las cosas me preocupan muchas veces (1)<br/>11.3. Las cosas me preocupan siempre (2)"] --> c12
    c12["12.<br/>12.1. Me gusta estar con la gente (0)<br/>12.2. Muy a menudo no me gusta estar con la gente (1)<br/>12.3. No quiero en absoluto estar con la gente (2)"] --> c13
    c13["13.<br/>13.1. Me decido fácilmente (0)<br/>13.2. Me cuesta decidirme (1)<br/>13.3. No puedo decidirme (2)"] --> c14
