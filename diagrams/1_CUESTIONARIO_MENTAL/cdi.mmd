    c24["24.<br/>24.1. Soy tan bueno como otros niños (0)<br/>24.2. Si quiero puedo ser tan bueno como otros niños (1)<br/>24.3. Nunca podré ser tan bueno como otros niños (2)"] --> c25
    c25["25.<br/>25.1. Nadie me quiere (0)<br/>25.2. No estoy seguro de que alguien me quiera (1)<br/>25.3. Estoy seguro de que alguien me quiere (2)"] --> c26
    c26["26.<br/>26.1. Generalmente hago lo que me dicen (0)<br/>26.2. Muchas veces no hago lo que me dicen (1)<br/>26.3. Nunca hago lo que me dicen (2)"] --> c27
    c27["27.<br/>27.1. Me llevo bien con la gente (0)<br/>27.2. Me peleo muchas veces (1)<br/>27.3. Me peleo siempre (2)"] --> res

    res(["Resultados CDI"]) --> fin(["Fin de cuestionario CDI"])
