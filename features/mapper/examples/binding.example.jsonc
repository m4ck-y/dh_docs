{
  // Store: MongoDB `dh_bindings`, colección `bindings`.
  // Vincula el valor de UNA pregunta (de un `form`) con UNA propiedad física 1:1.

  "name": "Fecha de nacimiento",             // opcional (display)

  "source": {
    "form": "datos_personales",              // form.key
    "question": "datos.fecha_nacimiento"     // question.key
  },

  "target": {
    "engine": "POSTGRES",                    // POSTGRES | MONGO
    "schema": "people",
    "table": "birth",
    "property": "birth_date",
    "operations": ["READ", "WRITE"]          // READ=prefill · WRITE=guardar · [] inválido
    // 1:N (varios registros): componente (ADR 045); match_on diferido si aplica.
  },

  "enabled": true

  // "transform" diferido. Opcional; se agrega cuando el valor ≠ columna destino.
  //   { "op": "SPLIT", ... } | { "op": "MAP", ... } | { "op": "EXPRESSION", "ast": {...} }

  // BaseModel: uuid (UUID v4), created_at, updated_at, created_by, updated_by (null al sembrar)
}
