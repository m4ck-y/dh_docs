{
  // PROPUESTA — un documento por binding.
  // Store: MongoDB `dh_mapper`, colección `bindings`.
  // Vincula el valor de UNA pregunta (de un `form`) con UNA propiedad física 1:1.
  "name": "Fecha de nacimiento",             // opcional (display)

  "source": {
    "form": "datos_personales",              // form.key
    "question": "datos.fecha_nacimiento"     // question.key
  },

  "target": {
    "engine": "POSTGRES",                    // POSTGRES | MONGO
    "schema": "people",
    "table": "birth",
    "property": "birth_date"
    // 1:N (varios registros, p.ej. people.address): NO va aquí — es componente
    // (ADR 045). Si algún día se requiere, se agrega `match_on: [col, ...]`.
  },

  "read": true,                              // prefill (UC2): solo si la pregunta está vacía
  "write": true,                             // write-through (UC1): solo si fue respondida; la respuesta manda
  // "transform" diferido. Opcional; se agrega cuando el valor de la respuesta ≠ columna destino.
  //   { "op": "SPLIT", "separator": " ", "parts": ["first_name","last_name",...] } // 1 resp → N cols
  //   { "op": "MAP", "map": { "1": "MUJER", "2": "HOMBRE" } }                     // valor → valor
  //   { "op": "EXPRESSION", "ast": { ... } }                                      // cálculo (reusa el AST)
  "enabled": true

  // BaseModel: uuid, created_at, updated_at, deleted_at, *_by_id_user
}
