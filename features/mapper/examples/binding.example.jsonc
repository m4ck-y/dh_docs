{
  // PROPUESTA — un documento por binding.
  // Store: MongoDB `dh_mapper`, colección `bindings`.
  // Vincula el valor de UNA pregunta con UNA propiedad física de dominio.
  "key": "apnp.6->people.address.address",   // UNIQUE, estable
  "name": "Domicilio (APNP)",
  "domain": "clinical_history",              // clinical_history | questionnaires (agrupación UI)

  "source": {
    "form_key": "apnp",                      // form.key
    "question_key": "apnp.6",                // question.key
    "question_uuid": null                    // opcional (ejecución, ADR 047)
  },

  "target": {
    "engine": "POSTGRES",                    // POSTGRES | MONGO
    "config": { "schema": "people", "table": "address" },  // según engine
    "property": "address",                   // columna / campo
    "match_on": ["id_person", "type_address"]  // para 1:N (upsert/append)
  },

  "operation": {
    "read": true,                            // prefill (UC2)
    "write": true,                           // write-through (UC1)
    "mode": "UPSERT"                         // UPSERT | APPEND | REPLACE
  },

  "transform": null,                         // null | SPLIT | MAP | EXPRESSION
  "conflict": "KEEP_EXISTING",               // KEEP_EXISTING | OVERWRITE | FLAG
  "enabled": true

  // BaseModel: uuid, created_at, updated_at, deleted_at, *_by_id_user
}
