{
  // PROPUESTA (alternativa) — un documento por form, con los bindings agrupados.
  // Store: MongoDB `dh_mapper`, colección `forms`.
  // Útil para render "por form"; pero editar 1 vínculo reescribe el doc entero
  // (riesgo de lost updates) y la unicidad se valida en app, no en índice.
  "form": "datos_personales",

  "list_bindings": [
    {
      "name": "Fecha de nacimiento",
      "source": { "form": "datos_personales", "question": "datos.fecha_nacimiento" },
      "target": {
        "engine": "POSTGRES",
        "schema": "people",
        "table": "birth",
        "property": "birth_date"
        // 1:N → componente (ADR 045); si aplica, `match_on: [col, ...]`.
      },
      "read": true,
      "write": true,
      // "transform" diferido (ver binding.example.jsonc)
      "enabled": true
    }

    // ... resto de bindings del mismo form (una entrada por pregunta con destino 1:1)
  ]

  // BaseModel: uuid, created_at, updated_at, deleted_at, *_by_id_user
}
