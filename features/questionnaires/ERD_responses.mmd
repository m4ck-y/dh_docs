erDiagram
    %% ===============================================================
    %% DECISIÓN DE ARQUITECTURA: ASSIGNMENT COMO TAREA/EVENTO
    %% Cada reevaluación o renovación (manual o programada) crea una 
    %% nueva fila en 'assignment'. No se usa como tabla maestra fija.
    %% ===============================================================

    form {
        string id PK
        string key
        string name
        string description
        BJSON scoring_expression
        BJSON evaluation_expression
    }

    assignment {
        string id PK
        string id_form FK
        string id_person FK
        %% status: ENABLED | IN_PROGRESS | COMPLETED | SUBMITTED | EXPIRED
        %% ENABLED      -> Front: "Cuestionario disponible" | Accion: Iniciar
        %% IN_PROGRESS  -> Front: "Continuar cuestionario" | Accion: Continuar
        %% COMPLETED    -> Front: "Revisa tus respuestas antes de enviar" | Accion: Enviar / Editar
        %% SUBMITTED    -> Front: "Cuestionario enviado" | Accion: Ver resumen/resultados (solo lectura)
        %% EXPIRED      -> Front: "El cuestionario vencio" | Accion: Ver respuestas incompletas (solo lectura)
        string status
        %% Trazabilidad y auditoría de la sesión completa
        string started_by
        string completed_by
        string submitted_by
        string started_at
        string completed_at
        string submitted_at
        %% Resultado definitivo de ESTA assignment. No es cache: como cada
        %% assignment es un evento unico, el resultado le pertenece.
        BJSON scoring_result
        BJSON evaluation_result
    }

    %% Ventana de disponibilidad temporal para cuestionarios programados.
    %% Solo existe si un profesional programo el cuestionario: en flujos
    %% directos (paciente auto-contesta) NO hay 'scheduled'.
    scheduled {
        string id PK
        string id_assignment FK
        %% Referencia al usuario (medico/enfermera/admin/sistema) que programo.
        %% No es un enum: es un FK a la entidad de usuarios.
        string assigned_by
        string available_from
        string available_until
        int time_limit_minutes
    }

    %% ===============================================================
    %% DECISIÓN DE ARQUITECTURA: TRAZABILIDAD POR PREGUNTA
    %% 'answered_by' vive en cada answer individual para auditar 
    %% si una pregunta específica la respondió el médico, tutor o paciente.
    %% ===============================================================
    answer {
        string id PK
        string id_assignment FK
        string id_question FK
        %% Referencia al usuario que ingreso esta respuesta puntual.
        %% Permite auditar si la contesto el medico, tutor o paciente.
        %% No es un enum: es un FK a la entidad de usuarios.
        string answered_by "ID del usuario (Médico / Tutor / Paciente)"
        JSON value
    }

    %% ===============================================================
    %% CARDINALIDADES DEL MODELO
    %% form --|| a |{-- assignment : un form tiene muchas assignments;
    %%   cada assignment pertenece a un unico form.
    %% assignment --o| a scheduled (cero o uno): un assignment tiene a lo
    %%   sumo UNA programacion. 'o' cubre el flujo directo (sin programar).
    %% assignment --|{ a answer : una assignment tiene muchas answers;
    %%   cada answer pertenece a una unica assignment.
    %% ===============================================================
    form ||--|{ assignment : "se asigna en"
    assignment ||--o| scheduled : "se programa en"
    assignment ||--|{ answer : "contiene respuestas de"