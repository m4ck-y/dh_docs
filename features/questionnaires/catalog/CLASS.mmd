classDiagram
    %% ===============================================================
    %% Vista de documentos (MongoDB) del catalogo.
    %% Se EXCLUYEN las entidades/clases puente (questions_form,
    %% questions_section): en un modelo documental la relacion se EMBEBE
    %% dentro del documento padre.
    %% Por eso el 'order' de la pregunta vive en Question (aqui), a
    %% diferencia del ERD relacional, donde el orden pertenece a la puente.
    %% Question es un subdocumento con 'id' (referencia estable), embebido
    %% dentro de Form y Section.
    %%
    %% INVARIANTE DE COMPOSICION (ver ADR 038): Form se compone de
    %% 'questions' (preguntas directas) O de 'sections', NUNCA de ambas.
    %% La exclusividad la valida la capa de aplicacion.
    %%
    %% Las expresiones (scoring/evaluation/condition) se TIPAN como Expression
    %% (AST embebido, no Jsonb opaco) y se enlazan por composicion. 'config' sigue
    %% siendo Jsonb porque su forma depende de Question.type. Gramatica del AST:
    %% features/questionnaires/expressions/README.md.
    %% ===============================================================

    class Form {
        +string id
        +string key
        +string name
        +string description
        +ExpressionSet expression
        +Expression condition
        %% XOR: o 'sections' o 'questions', nunca ambos (ver ADR 038)
        +Section[] sections
        +Question[] questions
    }

    class Section {
        +string id
        +string name
        +string description
        +int order
        +Expression condition
        +Question[] questions
    }

    class Question {
        +string id
        +string type
        +string text
        +int order
        +Jsonb config
        +Expression condition
        +Option[] options
    }

    %% Question.config: JSONB nullable, forma segun Question.type
    %% (ver catalog/question_types/). Incluye "required" y parametros del tipo.
    %% Question.order: aqui SI vive el orden (subdocumento embebido);
    %% en el ERD el orden vive en la puente (ver ERD.mmd).
    %% ExpressionSet (Form.expression): envelope de recetas.
    %% definitions: mapa de formulas con nombre (reutilizables via {ref}).
    %% scoring/evaluation son operadores (raiz SIN wrapper); subscales es un
    %% arreglo de ambitos, cada uno con su scoring/evaluation (scoping por contexto).
    class ExpressionSet {
        +Definition[] definitions
        +Expression scoring
        +Expression evaluation
        +Subscale[] subscales
    }

    %% Definition: formula con nombre (como un let). Se lee con OperandRef.
    class Definition {
        +string name
        +Expression expression
    }

    %% Subscale: ambito de scoring/evaluation. 'items' es la fuente de pertenencia.
    class Subscale {
        +string id
        +string name
        +int[] items
        +int max
        +Expression scoring
        +Expression evaluation
    }

    %% Expression (condition): operador AST raiz SIN wrapper.
    %% Expression (Form/Section/Question): la expresion se EMBEBE como subdocumento.
    %% Form usa ExpressionSet (scoring/evaluation/subscales) + condition; Section/Question solo condition.
    %% Ver ADR 039 y expressions/README.md.

    %% Expression: nodo del AST (operador). type/operator/args/output son
    %% comunes a todos; cases/default son propios de case/when (condition-based).
    %% (ver expressions/operators/case.md).
    class Expression {
        +string type
        +string operator
        +Operand[] args
        +Output output
        +CaseBranch[] cases
        +Operand default
    }

    %% Output: tipo del valor que produce la expresion.
    class Output {
        +string type
    }

    %% CaseBranch: una rama de case/when (when -> then). `when` es una
    %% condicion booleana (operando: expression | ref | const).
    class CaseBranch {
        +Operand when
        +Operand then
    }

    %% Operand: union de los 5 tipos de operando (ver expressions/operands.md).
    %% 'expression' permite la recursion: un operando puede contener otra Expression.
    class Operand {
        +Subject subject
        +Const const
        +Expression expression
        +TimeRange time_range
        +Ref ref
    }

    %% Ref: referencia a una Definition por nombre ({ "ref": "..." }).
    class Ref {
        +string name
    }

    class Option {
        +string id
        +string text
        +string value
        +int order
        +Url url
    }

    class Url {
        +string id
        +string href
        +string type
    }

    Form "1" *-- "0..*" Section : contiene (XOR questions)
    Form "1" *-- "0..*" Question : contiene (XOR sections)
    Section "1" *-- "0..*" Question : contiene
    Question "1" *-- "0..*" Option : contiene
    Option "1" o-- "0..1" Url : puede tener
    Form "1" *-- "0..1" ExpressionSet : expression
    Form "1" *-- "0..1" Expression : condition
    Section "1" *-- "0..1" Expression : condition
    Question "1" *-- "0..1" Expression : condition
    ExpressionSet "1" *-- "0..*" Definition : definitions
    Definition "1" *-- "0..1" Expression : expression
    ExpressionSet "1" *-- "0..1" Expression : scoring
    ExpressionSet "1" *-- "0..1" Expression : evaluation
    ExpressionSet "1" *-- "0..*" Subscale : subscales
    Subscale "1" *-- "0..1" Expression : scoring
    Subscale "1" *-- "0..1" Expression : evaluation
    Expression "1" *-- "0..*" Operand : args
    Expression "1" *-- "0..1" Output : output
    Expression "1" *-- "0..1" Operand : default
    Expression "1" *-- "0..*" CaseBranch : cases
    CaseBranch "1" *-- "0..1" Operand : when
    CaseBranch "1" *-- "0..1" Operand : then
    Operand "1" *-- "0..1" Expression : expression
    Operand "1" *-- "0..1" Ref : ref