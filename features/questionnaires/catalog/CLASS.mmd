classDiagram
    class Form {
        +string id
        +string key
        +string name
        +string description
        +Jsonb scoring_expression
        +Jsonb evaluation_expression
        +Section[] sections
        +FormQuestion[] questions
    }

    class Section {
        +string id
        +string name
        +string description
        +int order
        +SectionQuestion[] questions
    }

    class FormQuestion {
        +Question question
        +int order
    }

    class SectionQuestion {
        +Question question
        +int order
    }

    class Question {
        +string id
        +string type
        +string text
        +Jsonb config
        +Option[] options
        +Conditional conditional
    }

    %% Question.config: JSONB nullable, forma segun Question.type
    %% (ver catalog/question_types/). Incluye "required" y parametros del tipo.
    %% Question NO tiene order: su posicion vive en la relacion
    %% (FormQuestion.order / SectionQuestion.order), porque es reutilizable.

    class Option {
        +string id
        +string text
        +string value
        +int order
        +Url url
    }

    class Conditional {
        +string id
        +string triggered_by_question
        +string formula
        +string description
    }

    class Url {
        +string id
        +string href
        +string type
    }

    Form "1" *-- "0..*" Section : contiene
    Form "1" *-- "0..*" FormQuestion : contiene
    Section "1" *-- "0..*" SectionQuestion : contiene
    FormQuestion "1" *-- "1" Question : referencia
    SectionQuestion "1" *-- "1" Question : referencia
    Question "1" *-- "0..*" Option : contiene
    Question "1" *-- "0..1" Conditional : puede tener
    Option "1" o-- "0..1" Url : puede tener