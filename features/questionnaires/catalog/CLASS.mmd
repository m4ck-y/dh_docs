    %% ===============================================================
    %% Vista de documentos (MongoDB) del catalogo.
    %% Se EXCLUYEN las entidades/clases puente (questions_form,
    %% questions_section): en un modelo documental la relacion se EMBEBE
    %% dentro del documento padre.
    %% Por eso el 'order' de la pregunta vive en Question (aqui), a
    %% diferencia del ERD relacional, donde el orden pertenece a la puente.
    %% Question es un subdocumento con 'id' (referencia estable), embebido
    %% dentro de Form y Section.
    %%
    %% INVARIANTE DE COMPOSICION (ver ADR 038): Form se compone de
    %% 'questions' (preguntas directas) O de 'sections', NUNCA de ambas.
    %% La exclusividad la valida la capa de aplicacion.
    %%
    %% Las expresiones (scoring/evaluation/condition) se TIPAN como Expression
    %% (AST embebido, no Jsonb opaco) y se enlazan por composicion. 'config' sigue
    %% siendo Jsonb porque su forma depende de Question.type. Gramatica del AST:
    %% features/questionnaires/expressions/README.md.
    %% ===============================================================

    class Form {
        +string id
        +string key
        +string name
        +string description
        +Expression scoring_expression
        +Expression evaluation_expression
        +Expression condition
        %% XOR: o 'sections' o 'questions', nunca ambos (ver ADR 038)
        +Section[] sections
        +Question[] questions
    }

    class Section {
        +string id
        +string name
        +string description
        +int order
        +Expression condition
        +Question[] questions
    }

    class Question {
        +string id
        +string type
        +string text
        +int order
        +Jsonb config
        +Expression condition
        +Option[] options
    }

    %% Question.config: JSONB nullable, forma segun Question.type
    %% (ver catalog/question_types/). Incluye "required" y parametros del tipo.
    %% Question.order: aqui SI vive el orden (subdocumento embebido);
    %% en el ERD el orden vive en la puente (ver ERD.mmd).
    %% Expression (Form/Section/Question): la expresion se EMBEBE como subdocumento
    %% (AST). Form la usa para scoring/evaluation/condition; Section/Question solo
    %% para condition. Ver ADR 039 y expressions/README.md.

    %% Expression: nodo del AST (operador). type/operator/args/output son
    %% comunes a todos; subject/cases/default son propios de case/when
    %% (ver expressions/operators/case.md).
    class Expression {
        +string type
        +string operator
        +Operand[] args
        +Output output
        +Operand subject
        +CaseBranch[] cases
        +Operand default
    }

    %% Output: tipo del valor que produce la expresion.
    class Output {
        +string type
    }

    %% CaseBranch: una banda de case/when (when -> then).
    class CaseBranch {
        +Condition when
        +Operand then
    }

    %% Operand: union de los 4 tipos de operando (ver expressions/operands.md).
    %% 'expression' permite la recursion: un operando puede contener otra Expression.
    class Operand {
        +Subject subject
        +Const const
        +Expression expression
        +TimeRange time_range
    }

    class Option {
        +string id
        +string text
        +string value
        +int order
        +Url url
    }

    class Url {
        +string id
        +string href
        +string type
    }

    Form "1" *-- "0..*" Section : contiene (XOR questions)
    Form "1" *-- "0..*" Question : contiene (XOR sections)
    Section "1" *-- "0..*" Question : contiene
    Question "1" *-- "0..*" Option : contiene
    Option "1" o-- "0..1" Url : puede tener
    Form "1" *-- "0..1" Expression : scoring
    Form "1" *-- "0..1" Expression : evaluation
    Form "1" *-- "0..1" Expression : condition
    Section "1" *-- "0..1" Expression : condition
    Question "1" *-- "0..1" Expression : condition
    Expression "1" *-- "0..*" Operand : args
    Expression "1" *-- "0..1" Output : output
    Expression "1" *-- "0..1" Operand : subject
    Expression "1" *-- "0..1" Operand : default
    Expression "1" *-- "0..*" CaseBranch : cases
    Operand "1" *-- "0..1" Expression : expression