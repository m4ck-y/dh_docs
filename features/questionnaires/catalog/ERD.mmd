erDiagram
    %% SCHEMA form: catalogo de cuestionarios (definicion del instrumento)
    %% Fuente de verdad: docs/features/questionnaires/schema.sql (DDL de app_questionnaire)
    %% Fuente legacy del diagrama: reference_projects/reference_questionnaire_v1_legacy/FormsFlow2.drawio (pestana "Página-1")
    %% Todas las tablas heredan de BaseModel (agregados automaticamente, no se listan):
    %%   id Integer PK interno incremental, uuid UUID externo, created_at, updated_at, deleted_at, *_by_id_user
    %% Solo se listan las columnas especificas de cada entidad.
    %% Las FK referencian el id Integer interno de la tabla destino.
    %% Excepcion (decision de diseno): las tablas puente N:N conservan id propio.

    %% ============ RELACIONES ============
    %% INVARIANTE DE COMPOSICION (ver ADR 038): un form se compone de
    %% preguntas directas (form ||--o{ questions_form) O de secciones
    %% (form ||--o{ section), NUNCA de ambas. Mermaid ERD no expresa XOR;
    %% la exclusividad se valida en la capa de aplicacion (no en la BD).
    form ||--o{ reference : "documented_by"
    form ||--o{ form_categories : "classified_as"
    form_categories }o--|| category : "groups"
    form ||--o{ estimated_duration : "estimated_in"
    form ||--o{ target_age_groups : "targets_ages"
    target_age_groups }o--|| age_group : "groups"
    form ||--o{ section : "has"
    form ||--o{ questions_form : "asks"
    questions_form }o--|| question : "includes"
    section ||--o{ questions_section : "groups"
    questions_section }o--|| question : "includes"
    question ||--o{ option : "offers"
    option ||--o| url : "links_to"
    form ||--o{ target_sex : "restricts_sex"
    form ||--o{ form_population : "applies_to"
    form_population }o--|| population : "targets"
    form ||--o{ form_cie11_codes : "coded_with"
    form_cie11_codes }o--|| cie11_code : "codes"
    form ||--o{ form_evaluation_topics : "evaluates"
    form_evaluation_topics }o--|| evaluation_topic : "topic_of"

    %% ============ ENUMS ============
    %% EBiologicalSex: compartido con schema health_profile (HOMBRE=1, MUJER=2, INTERSEXUAL=3)
    EBiologicalSex {
        Integer HOMBRE "1"
        Integer MUJER "2"
        Integer INTERSEXUAL "3"
    }

    %% EQuestionType: tipos de pregunta (segun referencia app_questionnaire)
    %% La configuracion por tipo vive en question.config (JSONB), ver catalog/question_types/
    EQuestionType {
        String TEXT "TEXT"
        String TEXT_LONG "TEXT_LONG"
        String NUMBER "NUMBER"
        String SINGLE_CHOICE "SINGLE_CHOICE"
        String MULTIPLE_CHOICE "MULTIPLE_CHOICE"
        String DATE "DATE"
        String DATE_TIME "DATE_TIME"
        String TIMER "TIMER"
        String RANGE "RANGE"
    }

    %% EUrlType: tipo de recurso enlazado
    EUrlType {
        String LINK "LINK"
        String FILE "FILE"
        String IMAGE "IMAGE"
    }

    %% EUnit: unidad de un rango (age_group, estimated_duration)
    EUnit {
        String SECOND "SECOND"
        String MINUTE "MINUTE"
        String HOUR "HOUR"
        String DAY "DAY"
        String WEEK "WEEK"
        String MONTH "MONTH"
        String YEAR "YEAR"
    }

    %% EFormType: rol del formulario (distinto de EQuestionType = tipo de respuesta)
    EFormType {
        String INSTRUMENT "INSTRUMENT"
        String CLINICAL_HISTORY "CLINICAL_HISTORY"
        String SURVEY "SURVEY"
        String FORM "FORM"
    }

    %% ============ ENTIDADES ============
    %% form.key: UNIQUE NOT NULL
    %% form.verified: DEFAULT false
    %% La condicion de visibilidad es JSONB (AST booleano) en form/section/question
    %% (ver ADR 039 y expressions/conditions.md). Ausente = siempre visible.
    form {
        Integer id PK
        String key
        %% type: rol del formulario (EFormType). Distinto de question."type" (tipo de respuesta).
        Enum(EFormType) type
        %% name == filename ej: test.frm
        String name
        Text description
        %% instructions: texto de LLENADO para el paciente (como responder). Nullable.
        %% Distinto de description (tecnica). El texto amigable vive en el .md del banco.
        Text instructions
        %% envelope de recetas AST: {scoring?, evaluation?, subscales?}
        Jsonb expression
        %% condicion de visibilidad del formulario (AST booleano, raiz SIN wrapper)
        Jsonb condition
        %% verified=true => inmutable (no modificar form ni sus questions)
        Boolean verified
    }

    %% question.key: NOT NULL (usado en scoring/evaluacion y respuestas)
    %% question.config: JSONB nullable; forma segun question.type (ver catalog/question_types/)
    %% question.condition: condicion de visibilidad (AST booleano), ver ADR 039
    %% question.expression: receta del valor autocalculado (AST, una expresion, raiz
    %%   SIN wrapper); pregunta solo lectura. Ausente = la responde el usuario (C7c).
    %%   Contrato (ADR 042): text OBLIGATORIO, type compatible con el output, SIN
    %%   config, y NO es el resultado global del instrumento (eso es form.expression).
    %% El ORDEN no vive aqui: pertenece a la relacion (questions_form / questions_section),
    %% porque la pregunta es reutilizable y su posicion depende del contexto.
    %% question.text: NULLABLE (item sin enunciado propio, ej. CDI "elige la frase"; ver C17).
    question {
        Integer id PK
        String key
        Enum(EQuestionType) type
        Text text
        Jsonb config
        Jsonb condition
        Jsonb expression
    }

    evaluation_topic {
        Integer id PK
        String name
    }

    form_evaluation_topics {
        Integer id PK
        Integer id_form FK
        Integer id_evaluation_topic FK
    }

    reference {
        Integer id PK
        Integer id_form FK
        String url_reference
        String name
        Text notes
        String url_thumbnail
        String type_media
    }

    form_categories {
        Integer id PK
        Integer id_form FK
        Integer id_category FK
    }

    category {
        Integer id PK
        String key_industry
        String name
    }

    estimated_duration {
        %% name: etiqueta legible (fuente) para UI. El valor estructurado va en min/max/unit.
        %% unit: EUnit (MINUTE, HOUR, ...). Futuro (IA): sugerir name a partir del rango.
        Integer id PK
        Integer id_form FK
        String name
        Integer min
        Integer max
        Enum(EUnit) unit
    }

    target_age_groups {
        Integer id PK
        Integer id_form FK
        Integer id_age_group FK
    }

    age_group {
        %% name: etiqueta legible (fuente) para UI. min/max/unit llevan el valor (tipicamente YEAR o MONTH).
        Integer id PK
        String name
        Integer min
        Integer max
        Enum(EUnit) unit
    }

    %% section.key: opcional (identificador semantico de la seccion)
    %% section.condition: condicion de visibilidad (AST booleano), ver ADR 039
    %% Su existencia implica que el form usa secciones (sin preguntas directas).
    section {
        Integer id PK
        String key
        Integer id_form FK
        %% name: autoincmetene ej: 1, +1, 2
        String name
        Text description
        Integer order
        Jsonb condition
    }

    %% questions_form.order: posicion de la pregunta DENTRO de este formulario
    %% Exclusivo con el uso de secciones en el mismo formulario (ver ADR 038).
    questions_form {
        Integer id PK
        Integer id_form FK
        Integer id_question FK
        Integer order
    }

    %% questions_section.order: posicion de la pregunta DENTRO de esta seccion
    questions_section {
        Integer id PK
        Integer id_section FK
        Integer id_question FK
        Integer order
    }

    option {
        Integer id PK
        Integer id_question FK
        String text
        Integer value
        Integer order
        Text help
    }

    url {
        Integer id PK
        Integer id_option FK
        Enum(EUrlType) type
        String url
    }

    target_sex {
        Integer id PK
        Integer id_form FK
        Enum(EBiologicalSex) type_biological_sex
    }

    form_population {
        Integer id PK
        Integer id_form FK
        Integer id_population FK
    }

    population {
        Integer id PK
        String name
    }

    form_cie11_codes {
        Integer id PK
        Integer id_form FK
        Integer id_cie11_code FK
    }

    cie11_code {
        Integer id PK
        String code
    }

    %% ============ NOTAS DE DISENO ============
    %% Condicion de visibilidad (ADR 039): es una expresion AST booleana en JSONB,
    %% embebida en el propio elemento (form.condition / section.condition /
    %% question.condition). No hay tabla ni entidad compartida. Ausente = siempre
    %% visible. Ver features/questionnaires/expressions/conditions.md.
    %% Alternativa de optimizacion: embeber options en question como JSONB
    %% (question.options JSONB) en lugar de tabla option. Util cuando las preguntas
    %% siempre se leen junto con sus opciones.
    %% redirect_to: es necesario? Para saber a donde redirige despues de elegir una opcion
    %% de respuesta, despues de responder una pregunta, una seccion o un form.
    %% Agregar technical_description o hidden_description, visible solo para roles
    %% distintos al paciente.
    %% ABIERTO (TASK-016 C15): evaluar si los "target" (target_sex, age_group,
    %% population) deberian modelarse como parte de `condition` (AST de visibilidad)
    %% en lugar de tablas propias. Ver tasks/TASK-016-catalogo-cuestionarios/planning/pendientes.md.
