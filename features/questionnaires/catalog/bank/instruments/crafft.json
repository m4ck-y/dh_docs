{
  "id": "form-crafft",
  "key": "crafft",
  "type": "INSTRUMENT",
  "name": "CARLOS (CRAFFT)",
  "description": "Instrumento de tamizaje de consumo de alcohol y otras drogas en adolescentes y jóvenes: 3 preguntas de consumo (parte A) y 6 ítems C-R-A-F-F-T (parte B).",
  "instructions": "En los últimos seis meses",
  "verified": false,
  "condition": null,
  "expression": {
    "scoring": {
      "type": "aggregate",
      "operator": "sum",
      "args": [ { "subject": { "entity": "question", "property": "value", "selector": { "range": [4, 9] } } } ],
      "output": { "type": "number" }
    },
    "evaluation": {
      "type": "case",
      "operator": "when",
      "cases": [
        { "when": { "expression": { "type": "comparison", "operator": "<=",
                    "args": [ { "subject": { "entity": "form", "property": "result.scoring" } },
                              { "const": { "value": 1, "type": "number" } } ],
                    "output": { "type": "boolean" } } },
          "then": { "const": { "value": "No consumo", "type": "string" } } }
      ],
      "default": { "const": { "value": "Es necesario ser evaluado por un profesional", "type": "string" } },
      "output": { "type": "string" },
      "args": []
    }
  },
  "list_categories": [
    { "key": "wellbeing_physical", "name": "Bienestar físico" },
    { "key": "wellbeing_social", "name": "Bienestar social" }
  ],
  "list_evaluation_topics": [ { "name": "Adicciones" } ],
  "list_cie11_codes": [ { "code": "6C4" } ],
  "list_population": [ { "name": "Personas con sospecha de uso de sustancias" } ],
  "estimated_duration": { "name": "≤10 minutos", "max": 10, "unit": "MINUTE" },
  "list_age_groups": [ { "name": "12 a 21 años o personas que sospeche de adicciones", "min": 12, "max": 21, "unit": "YEAR" } ],
  "target_sex": null,
  "list_references": [
    { "name": "Instrumento de detección CRAFFT", "url_reference": "https://www.sename.cl/wsename/p15-03-12-2018/Anexo-11-Instrumento-Deteccion-CRAFFT.pdf", "type_media": "LINK" }
  ],
  "list_sections": [
    {
      "id": 1,
      "key": "A",
      "name": "Parte A — Consumo",
      "order": 1,
      "list_questions": [
        { "id": 1, "key": "crafft.a1", "type": "SINGLE_CHOICE", "order": 1,
          "text": "¿Has consumido bebidas con ALCOHOL (cerveza, vino, ginebra, etc.)?",
          "list_options": [ { "id": 1, "text": "Sí", "value": 1, "order": 1 }, { "id": 2, "text": "No", "value": 0, "order": 2 } ] },
        { "id": 2, "key": "crafft.a2", "type": "SINGLE_CHOICE", "order": 2,
          "text": "¿Has consumido MARIHUANA, HACHÍS, O MARIHUANA SINTÉTICA? Incluye fumada, vapeada o en cualquier tipo de alimento.",
          "list_options": [ { "id": 3, "text": "Sí", "value": 1, "order": 1 }, { "id": 4, "text": "No", "value": 0, "order": 2 } ] },
        { "id": 3, "key": "crafft.a3", "type": "SINGLE_CHOICE", "order": 3,
          "text": "¿Has consumido OTRAS DROGAS para colocarte (drogas ilegales, medicamentos con o sin receta, cualquier otra droga inhalada, vapeada o esnifada)?",
          "list_options": [ { "id": 5, "text": "Sí", "value": 1, "order": 1 }, { "id": 6, "text": "No", "value": 0, "order": 2 } ] }
      ]
    },
    {
      "id": 2,
      "key": "B",
      "name": "Parte B — CRAFFT",
      "order": 2,
      "list_questions": [
        { "id": 4, "key": "crafft.c", "type": "SINGLE_CHOICE", "order": 1,
          "text": "¿Alguna vez has andado en un AUTO manejado por alguien (incluyéndote a ti mismo) que estuviera «volado» o que estuviera consumiendo alcohol o drogas?",
          "list_options": [ { "id": 7, "text": "Sí", "value": 1, "order": 1 }, { "id": 8, "text": "No", "value": 0, "order": 2 } ] },
        { "id": 5, "key": "crafft.r", "type": "SINGLE_CHOICE", "order": 2,
          "text": "¿Has usado alguna vez alcohol o drogas para RELAJARTE, sentirte mejor contigo mismo o para ser parte de un grupo?",
          "condition": {
            "type": "collection", "operator": "any",
            "args": [ { "expression": { "type": "comparison", "operator": "==",
                "args": [
                  { "subject": { "entity": "question", "property": "value", "selector": { "range": [1, 3] } } },
                  { "const": { "value": 1, "type": "number" } }
                ], "output": { "type": "boolean" } } } ],
            "output": { "type": "boolean" } },
          "list_options": [ { "id": 9, "text": "Sí", "value": 1, "order": 1 }, { "id": 10, "text": "No", "value": 0, "order": 2 } ] },
        { "id": 6, "key": "crafft.a", "type": "SINGLE_CHOICE", "order": 3,
          "text": "¿Has consumido alguna vez alcohol o drogas estando SOLO?",
          "condition": {
            "type": "collection", "operator": "any",
            "args": [ { "expression": { "type": "comparison", "operator": "==",
                "args": [
                  { "subject": { "entity": "question", "property": "value", "selector": { "range": [1, 3] } } },
                  { "const": { "value": 1, "type": "number" } }
                ], "output": { "type": "boolean" } } } ],
            "output": { "type": "boolean" } },
          "list_options": [ { "id": 11, "text": "Sí", "value": 1, "order": 1 }, { "id": 12, "text": "No", "value": 0, "order": 2 } ] },
        { "id": 7, "key": "crafft.f1", "type": "SINGLE_CHOICE", "order": 4,
          "text": "¿Olvidaste cosas que hiciste mientras consumías alcohol o drogas?",
          "condition": {
            "type": "collection", "operator": "any",
            "args": [ { "expression": { "type": "comparison", "operator": "==",
                "args": [
                  { "subject": { "entity": "question", "property": "value", "selector": { "range": [1, 3] } } },
                  { "const": { "value": 1, "type": "number" } }
                ], "output": { "type": "boolean" } } } ],
            "output": { "type": "boolean" } },
          "list_options": [ { "id": 13, "text": "Sí", "value": 1, "order": 1 }, { "id": 14, "text": "No", "value": 0, "order": 2 } ] },
        { "id": 8, "key": "crafft.f2", "type": "SINGLE_CHOICE", "order": 5,
          "text": "¿Te ha dicho tu familia o AMIGOS que debes disminuir el consumo de alcohol o drogas?",
          "condition": {
            "type": "collection", "operator": "any",
            "args": [ { "expression": { "type": "comparison", "operator": "==",
                "args": [
                  { "subject": { "entity": "question", "property": "value", "selector": { "range": [1, 3] } } },
                  { "const": { "value": 1, "type": "number" } }
                ], "output": { "type": "boolean" } } } ],
            "output": { "type": "boolean" } },
          "list_options": [ { "id": 15, "text": "Sí", "value": 1, "order": 1 }, { "id": 16, "text": "No", "value": 0, "order": 2 } ] },
        { "id": 9, "key": "crafft.t", "type": "SINGLE_CHOICE", "order": 6,
          "text": "¿Has tenido problemas por consumir alcohol o drogas?",
          "condition": {
            "type": "collection", "operator": "any",
            "args": [ { "expression": { "type": "comparison", "operator": "==",
                "args": [
                  { "subject": { "entity": "question", "property": "value", "selector": { "range": [1, 3] } } },
                  { "const": { "value": 1, "type": "number" } }
                ], "output": { "type": "boolean" } } } ],
            "output": { "type": "boolean" } },
          "list_options": [ { "id": 17, "text": "Sí", "value": 1, "order": 1 }, { "id": 18, "text": "No", "value": 0, "order": 2 } ] }
      ]
    }
  ]
}
