{
  "id": "form-gds",
  "key": "gds",
  "kind": "INSTRUMENT",
  "name": "Escala de Depresión Geriátrica de Yesavage",
  "description": "Instrumento diseñado para ser empleado en población anciana para detectar la posible presencia de depresión.",
  "instructions": "En la última semana",
  "verified": false,
  "condition": null,
  "expression": {
    "scoring": {
      "type": "aggregate",
      "operator": "sum",
      "args": [ { "subject": { "entity": "question", "property": "value", "selector": { "all": true } } } ],
      "output": { "type": "number" }
    },
    "evaluation": {
      "type": "case",
      "operator": "when",
      "cases": [
        { "when": { "expression": { "type": "comparison", "operator": "<=",
                    "args": [ { "subject": { "entity": "form", "property": "result.scoring" } },
                              { "const": { "value": 4, "type": "number" } } ],
                    "output": { "type": "boolean" } } },
          "then": { "const": { "value": "Sin depresión", "type": "string" } } },
        { "when": { "expression": { "type": "comparison", "operator": "<=",
                    "args": [ { "subject": { "entity": "form", "property": "result.scoring" } },
                              { "const": { "value": 9, "type": "number" } } ],
                    "output": { "type": "boolean" } } },
          "then": { "const": { "value": "Probable depresión", "type": "string" } } }
      ],
      "default": { "const": { "value": "Depresión establecida", "type": "string" } },
      "output": { "type": "string" },
      "args": []
    }
  },
  "list_categories": [ { "key": "wellbeing_mental", "name": "Bienestar mental" } ],
  "list_evaluation_topics": [ { "name": "Depresión geriátrica" } ],
  "list_cie11_codes": [ { "code": "6A7" } ],
  "list_population": [],
  "estimated_duration": { "name": "≤15 minutos", "max": 15, "unit": "MINUTE" },
  "list_age_groups": [ { "name": ">60", "min": 61, "unit": "YEAR" } ],
  "target_sex": null,
  "list_references": [
    {
      "name": "Escala de Depresión Geriátrica de Yesavage (GDS)",
      "url_reference": "https://scielo.isciii.es/pdf/medif/v12n10/original2.pdf",
      "type_media": "LINK"
    }
  ],
  "list_questions": [
    { "id": 1, "key": "gds.1", "type": "SINGLE_CHOICE", "order": 1,
      "text": "¿Está Ud. básicamente satisfecho con su vida?",
      "list_options": [ { "id": 1, "text": "SÍ", "value": 0, "order": 1 }, { "id": 2, "text": "NO", "value": 1, "order": 2 } ] },
    { "id": 2, "key": "gds.2", "type": "SINGLE_CHOICE", "order": 2,
      "text": "¿Ha disminuido o abandonado muchos de sus intereses o actividades previas?",
      "list_options": [ { "id": 3, "text": "SÍ", "value": 1, "order": 1 }, { "id": 4, "text": "NO", "value": 0, "order": 2 } ] },
    { "id": 3, "key": "gds.3", "type": "SINGLE_CHOICE", "order": 3,
      "text": "¿Siente que su vida está vacía?",
      "list_options": [ { "id": 5, "text": "SÍ", "value": 1, "order": 1 }, { "id": 6, "text": "NO", "value": 0, "order": 2 } ] },
    { "id": 4, "key": "gds.4", "type": "SINGLE_CHOICE", "order": 4,
      "text": "¿Se siente aburrido frecuentemente?",
      "list_options": [ { "id": 7, "text": "SÍ", "value": 1, "order": 1 }, { "id": 8, "text": "NO", "value": 0, "order": 2 } ] },
    { "id": 5, "key": "gds.5", "type": "SINGLE_CHOICE", "order": 5,
      "text": "¿Está Ud. de buen ánimo la mayoría del tiempo?",
      "list_options": [ { "id": 9, "text": "SÍ", "value": 0, "order": 1 }, { "id": 10, "text": "NO", "value": 1, "order": 2 } ] },
    { "id": 6, "key": "gds.6", "type": "SINGLE_CHOICE", "order": 6,
      "text": "¿Está preocupado o teme que algo malo le va a pasar?",
      "list_options": [ { "id": 11, "text": "SÍ", "value": 1, "order": 1 }, { "id": 12, "text": "NO", "value": 0, "order": 2 } ] },
    { "id": 7, "key": "gds.7", "type": "SINGLE_CHOICE", "order": 7,
      "text": "¿Se siente feliz la mayor parte del tiempo?",
      "list_options": [ { "id": 13, "text": "SÍ", "value": 0, "order": 1 }, { "id": 14, "text": "NO", "value": 1, "order": 2 } ] },
    { "id": 8, "key": "gds.8", "type": "SINGLE_CHOICE", "order": 8,
      "text": "¿Se siente con frecuencia desamparado?",
      "list_options": [ { "id": 15, "text": "SÍ", "value": 1, "order": 1 }, { "id": 16, "text": "NO", "value": 0, "order": 2 } ] },
    { "id": 9, "key": "gds.9", "type": "SINGLE_CHOICE", "order": 9,
      "text": "¿Prefiere Ud. quedarse en casa a salir a hacer cosas nuevas?",
      "list_options": [ { "id": 17, "text": "SÍ", "value": 1, "order": 1 }, { "id": 18, "text": "NO", "value": 0, "order": 2 } ] },
    { "id": 10, "key": "gds.10", "type": "SINGLE_CHOICE", "order": 10,
      "text": "¿Siente Ud. que tiene más problemas con su memoria que otras personas de su edad?",
      "list_options": [ { "id": 19, "text": "SÍ", "value": 1, "order": 1 }, { "id": 20, "text": "NO", "value": 0, "order": 2 } ] },
    { "id": 11, "key": "gds.11", "type": "SINGLE_CHOICE", "order": 11,
      "text": "¿Cree Ud. que es maravilloso estar vivo?",
      "list_options": [ { "id": 21, "text": "SÍ", "value": 0, "order": 1 }, { "id": 22, "text": "NO", "value": 1, "order": 2 } ] },
    { "id": 12, "key": "gds.12", "type": "SINGLE_CHOICE", "order": 12,
      "text": "¿Se siente inútil o despreciable con está Ud. actualmente?",
      "list_options": [ { "id": 23, "text": "SÍ", "value": 1, "order": 1 }, { "id": 24, "text": "NO", "value": 0, "order": 2 } ] },
    { "id": 13, "key": "gds.13", "type": "SINGLE_CHOICE", "order": 13,
      "text": "¿Se siente lleno de energía?",
      "list_options": [ { "id": 25, "text": "SÍ", "value": 0, "order": 1 }, { "id": 26, "text": "NO", "value": 1, "order": 2 } ] },
    { "id": 14, "key": "gds.14", "type": "SINGLE_CHOICE", "order": 14,
      "text": "¿Se encuentra sin esperanza ante su situación actual?",
      "list_options": [ { "id": 27, "text": "SÍ", "value": 1, "order": 1 }, { "id": 28, "text": "NO", "value": 0, "order": 2 } ] },
    { "id": 15, "key": "gds.15", "type": "SINGLE_CHOICE", "order": 15,
      "text": "¿Cree que la mayoría de las personas son mejores que usted?",
      "list_options": [ { "id": 29, "text": "SÍ", "value": 1, "order": 1 }, { "id": 30, "text": "NO", "value": 0, "order": 2 } ] }
  ]
}
