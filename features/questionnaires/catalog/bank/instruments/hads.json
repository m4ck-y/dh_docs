{
  "id": "form-hads",
  "key": "hads",
  "kind": "INSTRUMENT",
  "name": "Escala de Ansiedad y Depresión Hospitalaria",
  "description": "Instrumento diseñado para detectar trastornos de ansiedad y depresión en servicios hospitalarios no psiquiátricos en pacientes que no estuvieran contaminados por la sintomatología de una enfermedad física.",
  "instructions": "Lea cada pregunta y seleccione la respuesta que usted considere que coincide con su propio estado emocional en la última semana. No es necesario que piense mucho tiempo cada respuesta; en este cuestionario las respuestas espontáneas tienen más valor que las que se piensan mucho.",
  "verified": false,
  "condition": null,
  "expression": {
    "subscales": [
      {
        "id": "A",
        "name": "Ansiedad",
        "items": [1, 3, 5, 7, 9, 11, 13],
        "max": 21,
        "scoring": {
          "type": "aggregate",
          "operator": "sum",
          "args": [ { "subject": { "entity": "question", "property": "value" } } ],
          "output": { "type": "number" }
        },
        "evaluation": {
          "type": "case",
          "operator": "when",
          "cases": [
            { "when": { "expression": { "type": "comparison", "operator": "<=",
                        "args": [ { "subject": { "entity": "form", "property": "result.scoring" } },
                                  { "const": { "value": 7, "type": "number" } } ],
                        "output": { "type": "boolean" } } },
              "then": { "const": { "value": "Normalidad", "type": "string" } } },
            { "when": { "expression": { "type": "comparison", "operator": "<=",
                        "args": [ { "subject": { "entity": "form", "property": "result.scoring" } },
                                  { "const": { "value": 10, "type": "number" } } ],
                        "output": { "type": "boolean" } } },
              "then": { "const": { "value": "Probable ansiedad", "type": "string" } } }
          ],
          "default": { "const": { "value": "Caso de ansiedad", "type": "string" } },
          "output": { "type": "string" },
          "args": []
        }
      },
      {
        "id": "D",
        "name": "Depresión",
        "items": [2, 4, 6, 8, 10, 12, 14],
        "max": 21,
        "scoring": {
          "type": "aggregate",
          "operator": "sum",
          "args": [ { "subject": { "entity": "question", "property": "value" } } ],
          "output": { "type": "number" }
        },
        "evaluation": {
          "type": "case",
          "operator": "when",
          "cases": [
            { "when": { "expression": { "type": "comparison", "operator": "<=",
                        "args": [ { "subject": { "entity": "form", "property": "result.scoring" } },
                                  { "const": { "value": 7, "type": "number" } } ],
                        "output": { "type": "boolean" } } },
              "then": { "const": { "value": "Normalidad", "type": "string" } } },
            { "when": { "expression": { "type": "comparison", "operator": "<=",
                        "args": [ { "subject": { "entity": "form", "property": "result.scoring" } },
                                  { "const": { "value": 10, "type": "number" } } ],
                        "output": { "type": "boolean" } } },
              "then": { "const": { "value": "Probable depresión", "type": "string" } } }
          ],
          "default": { "const": { "value": "Caso de depresión", "type": "string" } },
          "output": { "type": "string" },
          "args": []
        }
      }
    ]
  },
  "list_categories": [ { "key": "wellbeing_mental", "name": "Bienestar mental" } ],
  "list_evaluation_topics": [ { "name": "Ansiedad y depresión en pacientes con visitas constantes al hospital" } ],
  "list_cie11_codes": [ { "code": "6A7" }, { "code": "6B0" } ],
  "list_population": [ { "name": "Población con tratamiento hospitalario" } ],
  "estimated_duration": { "name": "≤15 minutos", "max": 15, "unit": "MINUTE" },
  "list_age_groups": [ { "name": "≥14 años", "min": 14, "unit": "YEAR" } ],
  "target_sex": null,
  "list_references": [
    {
