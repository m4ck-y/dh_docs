  ],
  "list_questions": [
    { "id": 1, "key": "pss.1", "type": "SINGLE_CHOICE", "order": 1,
      "text": "¿Con qué frecuencia ha estado afectado por algo que me ha ocurrido inesperadamente?",
      "list_options": [ { "id": 1, "text": "Nunca", "value": 0, "order": 1 }, { "id": 2, "text": "Casi nunca", "value": 1, "order": 2 }, { "id": 3, "text": "De vez en cuando", "value": 2, "order": 3 }, { "id": 4, "text": "A menudo", "value": 3, "order": 4 }, { "id": 5, "text": "Muy a menudo", "value": 4, "order": 5 } ] },
    { "id": 2, "key": "pss.2", "type": "SINGLE_CHOICE", "order": 2,
      "text": "¿Con qué frecuencia se ha sentido incapaz de controlar las cosas importantes en su vida?",
      "list_options": [ { "id": 6, "text": "Nunca", "value": 0, "order": 1 }, { "id": 7, "text": "Casi nunca", "value": 1, "order": 2 }, { "id": 8, "text": "De vez en cuando", "value": 2, "order": 3 }, { "id": 9, "text": "A menudo", "value": 3, "order": 4 }, { "id": 10, "text": "Muy a menudo", "value": 4, "order": 5 } ] },
    { "id": 3, "key": "pss.3", "type": "SINGLE_CHOICE", "order": 3,
      "text": "¿Con qué frecuencia se ha sentido nervioso o estresado?",
      "list_options": [ { "id": 11, "text": "Nunca", "value": 0, "order": 1 }, { "id": 12, "text": "Casi nunca", "value": 1, "order": 2 }, { "id": 13, "text": "De vez en cuando", "value": 2, "order": 3 }, { "id": 14, "text": "A menudo", "value": 3, "order": 4 }, { "id": 15, "text": "Muy a menudo", "value": 4, "order": 5 } ] },
    { "id": 4, "key": "pss.4", "type": "SINGLE_CHOICE", "order": 4,
      "text": "¿Con qué frecuencia ha manejado con éxito los pequeños problemas irritantes de la vida? (invertido)",
      "list_options": [ { "id": 16, "text": "Nunca", "value": 4, "order": 1 }, { "id": 17, "text": "Casi nunca", "value": 3, "order": 2 }, { "id": 18, "text": "De vez en cuando", "value": 2, "order": 3 }, { "id": 19, "text": "A menudo", "value": 1, "order": 4 }, { "id": 20, "text": "Muy a menudo", "value": 0, "order": 5 } ] },
    { "id": 5, "key": "pss.5", "type": "SINGLE_CHOICE", "order": 5,
      "text": "¿Con qué frecuencia ha sentido que ha afrontado efectivamente los cambios importantes que han estado ocurriendo en su vida? (invertido)",
      "list_options": [ { "id": 21, "text": "Nunca", "value": 4, "order": 1 }, { "id": 22, "text": "Casi nunca", "value": 3, "order": 2 }, { "id": 23, "text": "De vez en cuando", "value": 2, "order": 3 }, { "id": 24, "text": "A menudo", "value": 1, "order": 4 }, { "id": 25, "text": "Muy a menudo", "value": 0, "order": 5 } ] },
    { "id": 6, "key": "pss.6", "type": "SINGLE_CHOICE", "order": 6,
      "text": "¿Con qué frecuencia ha estado seguro sobre su capacidad para manejar sus problemas personales? (invertido)",
      "list_options": [ { "id": 26, "text": "Nunca", "value": 4, "order": 1 }, { "id": 27, "text": "Casi nunca", "value": 3, "order": 2 }, { "id": 28, "text": "De vez en cuando", "value": 2, "order": 3 }, { "id": 29, "text": "A menudo", "value": 1, "order": 4 }, { "id": 30, "text": "Muy a menudo", "value": 0, "order": 5 } ] },
    { "id": 7, "key": "pss.7", "type": "SINGLE_CHOICE", "order": 7,
      "text": "¿Con qué frecuencia ha sentido que las cosas le van bien? (invertido)",
      "list_options": [ { "id": 31, "text": "Nunca", "value": 4, "order": 1 }, { "id": 32, "text": "Casi nunca", "value": 3, "order": 2 }, { "id": 33, "text": "De vez en cuando", "value": 2, "order": 3 }, { "id": 34, "text": "A menudo", "value": 1, "order": 4 }, { "id": 35, "text": "Muy a menudo", "value": 0, "order": 5 } ] },
    { "id": 8, "key": "pss.8", "type": "SINGLE_CHOICE", "order": 8,
      "text": "¿Con qué frecuencia ha sentido que no podía afrontar todas las cosas que tenía que hacer?",
      "list_options": [ { "id": 36, "text": "Nunca", "value": 0, "order": 1 }, { "id": 37, "text": "Casi nunca", "value": 1, "order": 2 }, { "id": 38, "text": "De vez en cuando", "value": 2, "order": 3 }, { "id": 39, "text": "A menudo", "value": 3, "order": 4 }, { "id": 40, "text": "Muy a menudo", "value": 4, "order": 5 } ] },
    { "id": 9, "key": "pss.9", "type": "SINGLE_CHOICE", "order": 9,
      "text": "¿Con qué frecuencia ha podido controlar las dificultades de su vida? (invertido)",
      "list_options": [ { "id": 41, "text": "Nunca", "value": 4, "order": 1 }, { "id": 42, "text": "Casi nunca", "value": 3, "order": 2 }, { "id": 43, "text": "De vez en cuando", "value": 2, "order": 3 }, { "id": 44, "text": "A menudo", "value": 1, "order": 4 }, { "id": 45, "text": "Muy a menudo", "value": 0, "order": 5 } ] },
    { "id": 10, "key": "pss.10", "type": "SINGLE_CHOICE", "order": 10,
      "text": "¿Con qué frecuencia se ha sentido que tenia todo bajo control? (invertido)",
      "list_options": [ { "id": 46, "text": "Nunca", "value": 4, "order": 1 }, { "id": 47, "text": "Casi nunca", "value": 3, "order": 2 }, { "id": 48, "text": "De vez en cuando", "value": 2, "order": 3 }, { "id": 49, "text": "A menudo", "value": 1, "order": 4 }, { "id": 50, "text": "Muy a menudo", "value": 0, "order": 5 } ] },
    { "id": 11, "key": "pss.11", "type": "SINGLE_CHOICE", "order": 11,
      "text": "¿Con qué frecuencia ha estado enfadado porque las cosas que le han ocurrido estaban fuera de su control?",
      "list_options": [ { "id": 51, "text": "Nunca", "value": 0, "order": 1 }, { "id": 52, "text": "Casi nunca", "value": 1, "order": 2 }, { "id": 53, "text": "De vez en cuando", "value": 2, "order": 3 }, { "id": 54, "text": "A menudo", "value": 3, "order": 4 }, { "id": 55, "text": "Muy a menudo", "value": 4, "order": 5 } ] },
    { "id": 12, "key": "pss.12", "type": "SINGLE_CHOICE", "order": 12,
      "text": "¿Con qué frecuencia ha pensado sobre las cosas que le quedan por hacer?",
      "list_options": [ { "id": 56, "text": "Nunca", "value": 0, "order": 1 }, { "id": 57, "text": "Casi nunca", "value": 1, "order": 2 }, { "id": 58, "text": "De vez en cuando", "value": 2, "order": 3 }, { "id": 59, "text": "A menudo", "value": 3, "order": 4 }, { "id": 60, "text": "Muy a menudo", "value": 4, "order": 5 } ] },
    { "id": 13, "key": "pss.13", "type": "SINGLE_CHOICE", "order": 13,
      "text": "¿Con qué frecuencia ha podido controlar la forma de pasar el tiempo? (invertido)",
      "list_options": [ { "id": 61, "text": "Nunca", "value": 4, "order": 1 }, { "id": 62, "text": "Casi nunca", "value": 3, "order": 2 }, { "id": 63, "text": "De vez en cuando", "value": 2, "order": 3 }, { "id": 64, "text": "A menudo", "value": 1, "order": 4 }, { "id": 65, "text": "Muy a menudo", "value": 0, "order": 5 } ] },
    { "id": 14, "key": "pss.14", "type": "SINGLE_CHOICE", "order": 14,
      "text": "¿Con qué frecuencia ha sentido que la dificultades se acumulan tanto que no puede superarlas?",
      "list_options": [ { "id": 66, "text": "Nunca", "value": 0, "order": 1 }, { "id": 67, "text": "Casi nunca", "value": 1, "order": 2 }, { "id": 68, "text": "De vez en cuando", "value": 2, "order": 3 }, { "id": 69, "text": "A menudo", "value": 3, "order": 4 }, { "id": 70, "text": "Muy a menudo", "value": 4, "order": 5 } ] }
  ]
