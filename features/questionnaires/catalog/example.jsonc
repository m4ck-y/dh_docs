{
  "key": "ENCUESTA123",
  "name": "Encuesta de Satisfacción",
  "description": "Formulario para evaluar el servicio ofrecido",
  "verified": false,
  /* Expresiones en el AST del proyecto (ver ../expressions/README.md). */
  "scoring_expression": {
    "expression": {
      "type": "aggregate",
      "operator": "sum",
      "args": [
        { "subject": { "entity": "question", "property": "value", "selector": { "all": true } } }
      ],
      "output_data_type": "number"
    }
  },
  "evaluation_expression": {
    "expression": {
      "type": "case",
      "operator": "when",
      "subject": { "subject": { "entity": "form", "property": "scoring_result" } },
      "cases": [
        {
          "when": { "operator": "<=", "operand": { "const": { "value": 5, "data_type": "number" } } },
          "then": { "const": { "value": "Satisfacción baja", "data_type": "string" } }
        }
      ],
      "default": { "const": { "value": "Satisfacción alta", "data_type": "string" } },
      "output_data_type": "string",
      "args": []
    }
  },
  /* Visibilidad del formulario (AST booleano). Ausente = siempre visible.
     Ver expressions/conditions.md */
  "condition": {
    "expression": {
      "type": "comparison",
      "operator": ">=",
      "args": [
        { "subject": { "entity": "person", "property": "age" } },
        { "const": { "value": 18, "data_type": "number" } }
      ],
      "output_data_type": "boolean"
    }
  },
  "id": 0,
  /* EXCLUSIVIDAD (ver ADR 038 y catalog/README.md §7):
     un form usa list_questions (preguntas directas) O list_sections
     (secciones con sus preguntas), nunca ambos. Este ejemplo ilustra el
     caso con secciones, por lo que list_questions se omite. */
  "list_sections": [
    {
      "name": "Section 1",
      "description": "Sección para recopilar datos personales del encuestado",
      "order": 1,
      "id": 0,
      /* Visibilidad de la sección (AST booleano). Ausente = siempre visible. */
      "condition": {
        "expression": {
          "type": "comparison",
          "operator": "==",
          "args": [
            { "subject": { "entity": "person", "property": "sex" } },
            { "const": { "value": "F", "data_type": "string" } }
          ],
          "output_data_type": "boolean"
        }
      },
      "list_questions": [
        {
          "type": "SINGLE_CHOICE",
          "text": "¿Cómo calificaría la atención recibida?",
          "order": 1,
          "id": 0,
          "list_options": [
            {
              "text": "string",
              "value": 0,
              "order": 1,
              "id": 0,
              "url": { "value": "http://wwww.pinterest.com/image.png", "type": "LINK", "id": 0 }
            }
          ],
          "condition": {
            /* Visibilidad: AST booleano. Ver expressions/conditions.md */
            "expression": {
              "type": "comparison",
              "operator": ">",
              "args": [
                { "subject": { "entity": "question", "property": "value", "selector": { "id": 1 } } },
                { "const": { "value": 0, "data_type": "number" } }
              ],
              "output_data_type": "boolean"
            }
          }
        },
        {
          /* config segun question.type (ver catalog/question_types/) */
          "type": "RANGE",
          "text": "Durante los últimos 7 días, ¿cuántos días realizó actividades físicas vigorosas?",
          "order": 2,
          "id": 0,
          "config": { "required": true, "min": 0, "max": 7, "step": 1, "integer": true }
        },
        {
          "type": "TIMER",
          "text": "¿Cuánto tiempo en total dedicó a caminar en uno de esos días?",
          "order": 3,
          "id": 0,
          "config": { "required": true, "min": "PT0M", "max": "PT24H", "precision": "minutes" }
        }
      ]
    }
  ],
  /* list_evaluation_topics corresponde a las tablas form_evaluation_topics (puente) y evaluation_topic del ERD.mmd */
  "list_evaluation_topics": [
    { "name": "string", "id": 0 }
  ],
  "list_references": [
    {
      "url_reference": "string",
      "name": "string",
      "notes": "string",
      "url_thumbnail": "string",
      "type_media": "FILE",
      "id": 0
    }
  ],
  "list_categories": [
    { "key_industry": "string", "name": "string", "id": 0 }
  ],
  "estimated_duration": {
    "min_minutes": 0,
    "max_minutes": 0,
    "description": "string",
    "id": 0
  },
  "target_age_groups": [
    {
      "name": "string",
      "min_age": 0,
      "max_age": 0,
      "id": 0
    }
  ],
  "target_sex": {
    "type_biological_sex": "HOMBRE",
    "id": 0
  }
}