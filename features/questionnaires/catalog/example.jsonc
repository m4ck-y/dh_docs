{
  "key": "ENCUESTA123",
  "name": "Encuesta de Satisfacción",
  "description": "Formulario para evaluar el servicio ofrecido",
  /* Texto de LLENADO para el paciente (cómo responder). Nullable.
     Distinto de description (técnica). El texto amigable vive en el .md del banco. */
  "instructions": "Conteste cada pregunta pensando en los últimos 7 días.",
  "verified": false,
  /* Envelope de recetas AST del formulario (raíz sin wrapper).
     Ver ../expressions/README.md. */
  "expression": {
    "scoring": {
      "type": "aggregate",
      "operator": "sum",
      "args": [
        { "subject": { "entity": "question", "property": "value", "selector": { "all": true } } }
      ],
      "output": { "type": "number" }
    },
    "evaluation": {
      "type": "case",
      "operator": "when",
      "cases": [
        {
          "when": { "expression": { "type": "comparison", "operator": "<=",
                    "args": [ { "subject": { "entity": "form", "property": "result.scoring" } },
                              { "const": { "value": 5, "type": "number" } } ],
                    "output": { "type": "boolean" } } },
          "then": { "const": { "value": "Satisfacción baja", "type": "string" } }
        }
      ],
      "default": { "const": { "value": "Satisfacción alta", "type": "string" } },
      "output": { "type": "string" },
      "args": []
    }
  },
  /* Visibilidad del formulario (AST booleano, raíz sin wrapper). Ausente = siempre visible.
     Ver expressions/conditions.md */
  "condition": {
    "type": "comparison",
    "operator": ">=",
    "args": [
      { "subject": { "entity": "person", "property": "age" } },
      { "const": { "value": 18, "type": "number" } }
    ],
    "output": { "type": "boolean" }
  },
  "id": 0,
  /* EXCLUSIVIDAD (ver ADR 038 y catalog/README.md §7):
     un form usa list_questions (preguntas directas) O list_sections
     (secciones con sus preguntas), nunca ambos. Este ejemplo ilustra el
     caso con secciones, por lo que list_questions se omite. */
  "list_sections": [
    {
      "name": "Section 1",
      "description": "Sección para recopilar datos personales del encuestado",
      "order": 1,
      "id": 0,
      /* Visibilidad de la sección (AST booleano, raíz sin wrapper). Ausente = siempre visible. */
      "condition": {
        "type": "comparison",
        "operator": "==",
        "args": [
          { "subject": { "entity": "person", "property": "sex" } },
          { "const": { "value": "F", "type": "string" } }
        ],
        "output": { "type": "boolean" }
      },
      "list_questions": [
        {
          "type": "SINGLE_CHOICE",
          "text": "¿Cómo calificaría la atención recibida?",
          "order": 1,
          "id": 0,
          "list_options": [
            {
              "text": "string",
              "value": 0,
              "order": 1,
              "id": 0,
              "url": { "value": "http://wwww.pinterest.com/image.png", "type": "LINK", "id": 0 }
            }
          ],
          "condition": {
            /* Visibilidad: AST booleano, raíz sin wrapper. Ver expressions/conditions.md */
            "type": "comparison",
            "operator": ">",
            "args": [
              { "subject": { "entity": "question", "property": "value", "selector": { "id": 1 } } },
              { "const": { "value": 0, "type": "number" } }
            ],
            "output": { "type": "boolean" }
          }
        },
        {
          /* config segun question.type (ver catalog/question_types/) */
          "type": "RANGE",
          "text": "Durante los últimos 7 días, ¿cuántos días realizó actividades físicas vigorosas?",
          "order": 2,
          "id": 0,
          "config": { "required": true, "min": 0, "max": 7, "step": 1, "integer": true }
        },
        {
          "type": "TIMER",
          "text": "¿Cuánto tiempo en total dedicó a caminar en uno de esos días?",
          "order": 3,
          "id": 0,
          "config": { "required": true, "min": "PT0M", "max": "PT24H", "precision": "minutes" }
        },
        {
          /* Pregunta AUTOCALCULADA (solo lectura): su valor sale de "expression",
             no la responde el usuario. Se persiste como answer con source=CALCULATED
             al enviar (snapshot). Ver ../expressions/README.md (C7c). */
          "type": "NUMBER",
          "text": "Puntaje total (calculado)",
          "order": 4,
          "id": 0,
          "expression": {
            "type": "aggregate",
            "operator": "sum",
            "args": [
              { "subject": { "entity": "question", "property": "value", "selector": { "range": [1, 3] } } }
            ],
            "output": { "type": "number" }
          }
        }
      ]
    }
  ],
  /* list_evaluation_topics corresponde a las tablas form_evaluation_topics (puente) y evaluation_topic del ERD.mmd */
  "list_evaluation_topics": [
    { "name": "string", "id": 0 }
  ],
  "list_references": [
    {
      "url_reference": "string",
      "name": "string",
      "notes": "string",
      "url_thumbnail": "string",
      "type_media": "FILE",
      "id": 0
    }
  ],
  "list_categories": [
    { "key_industry": "string", "name": "string", "id": 0 }
  ],
  "estimated_duration": {
    "min_minutes": 0,
    "max_minutes": 0,
    "description": "string",
    "id": 0
  },
  "target_age_groups": [
    {
      "name": "string",
      "min_age": 0,
      "max_age": 0,
      "id": 0
    }
  ],
  "target_sex": {
    "type_biological_sex": "HOMBRE",
    "id": 0
  }
}