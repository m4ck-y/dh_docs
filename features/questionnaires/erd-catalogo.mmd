erDiagram
    %% Fuente: other_projects/app_questionnaire/backend/docs/db_ddl.sql (tablas form/question)
    %% Adaptado a convenciones dh_ (UUID, soft-delete, esquema "catalog").
    %% Solo cubre la DEFINICION del catalogo; respuesta/asignacion se modelan aparte.
    %% All entities inherit from BaseModel (id, uuid, created_at, updated_at, deleted_at, *_by_id_user)
    %% Only entity-specific columns are shown below.

    %% ============ RELATIONSHIPS ============
    questionnaire ||--o{ questionnaire_item : "contains"
    questionnaire_item ||--o{ questionnaire_item : "nested_in"
    questionnaire_item ||--o{ questionnaire_option : "offers"
    questionnaire_item ||--o{ questionnaire_condition : "enabled_by"
    questionnaire_item ||--o{ questionnaire_condition : "references"
    questionnaire }o--o{ category : "classified_as"
    questionnaire }o--o{ cie11_code : "coded_with"
    questionnaire ||--o{ evaluation_topic : "evaluates"
    questionnaire ||--o{ reference : "documented_by"

    %% ============ ENUMS ============
    EQuestionnaireItemType {
        String GROUP "GROUP"
        String SINGLE_CHOICE "SINGLE_CHOICE"
        String MULTIPLE_CHOICE "MULTIPLE_CHOICE"
        String TEXT "TEXT"
    }

    EConditionalBehavior {
        String ALL "all"
        String ANY "any"
        String NONE "none"
    }

    EConditionalOperator {
        String EQUAL "=="
        String NOT_EQUAL "!="
        String GREATER_THAN ">"
        String LESS_THAN "<"
        String GREATER_EQUAL ">="
        String LESS_EQUAL "<="
        String INCLUDES "includes"
        String NOT_INCLUDES "notIncludes"
        String IN "in"
        String NOT_IN "notIn"
        String EXISTS "exists"
        String NOT_EMPTY "notEmpty"
    }

    %% ============ ENTITIES ============
    questionnaire {
        String key UK
        String name
        Text description
        String area
        String area_desc
        Text instrucciones
        Jsonb scoring_expression
        Jsonb evaluation_expression
        Boolean verified
        Integer min_age
        Integer max_age
        String target_age_name
        String target_sex
        Integer min_minutes
        Integer max_minutes
    }

    questionnaire_item {
        Integer id_questionnaire FK
        Integer parent_item_id FK
        String key
        Text text
        Enum(EQuestionnaireItemType) item_type
        Integer position
        Boolean required
        Boolean repeats
    }

    questionnaire_option {
        Integer id_questionnaire_item FK
        String text
        Integer value
        Integer position
    }

    questionnaire_condition {
        Integer id_questionnaire_item FK
        Integer id_origin_item FK
        Enum(EConditionalBehavior) behavior
        Enum(EConditionalOperator) operator
        String value
    }

    category {
        String key_industry UK
        String name
    }

    cie11_code {
        String code UK
    }

    evaluation_topic {
        Integer id_questionnaire FK
        String name
        String key_industry
        Text description
    }

    reference {
        Integer id_questionnaire FK
        String url_reference
        String name
        String notes
        String url_thumbnail
        String reference_type
    }

    questionnaire_categories {
        Integer id_questionnaire PK,FK
        Integer id_category PK,FK
    }

    questionnaire_cie11_codes {
        Integer id_questionnaire PK,FK
        Integer id_cie11_code PK,FK
    }
