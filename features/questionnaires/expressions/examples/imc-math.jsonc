{
  /* Ejemplo de math anidado: IMC = peso / (altura ^ 2).
     NO es scoring; demuestra la anidacion del AST (operador raiz SIN wrapper;
     el operando anidado va con wrapper {expression:...}).
     Ver ../README.md §1. */
  "type": "math",
  "operator": "/",
  "args": [
    {
      "subject": {
        "entity": "person",
        "property": "weight"
      }
    },
    {
      "expression": {
        "type": "math",
        "operator": "^",
        "args": [
          {
            "subject": {
              "entity": "person",
              "property": "height"
            }
          },
          {
            "const": {
              "value": 2,
              "type": "number"
            }
          }
        ],
        "output": { "type": "number" }
      }
    }
  ],
  "output": { "type": "number" }
}
