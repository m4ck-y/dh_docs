{
  /* form.expression del PHQ-9 (1 escala): envelope { scoring, evaluation }.
     Las claves scoring/evaluation son operadores directos (raiz SIN wrapper).
     La evaluation usa `case` condition-based: cada `when` es una condicion
     booleana (operando). Ver ../README.md §1/§6 y ../operators/case.md. */
  "scoring": {
    "type": "aggregate",
    "operator": "sum",
    "args": [
      {
        "subject": {
          "entity": "question",
          "property": "value",
          "selector": { "all": true }
        }
      }
    ],
    "output": { "type": "number" }
  },
  "evaluation": {
    "type": "case",
    "operator": "when",
    "cases": [
      {
        "when": { "expression": { "type": "comparison", "operator": "<",
                  "args": [ { "subject": { "entity": "form", "property": "result.scoring" } },
                            { "const": { "value": 5, "type": "number" } } ],
                  "output": { "type": "boolean" } } },
        "then": { "const": { "value": "Depresión mínima", "type": "string" } }
      },
      {
        "when": { "expression": { "type": "comparison", "operator": "<",
                  "args": [ { "subject": { "entity": "form", "property": "result.scoring" } },
                            { "const": { "value": 10, "type": "number" } } ],
                  "output": { "type": "boolean" } } },
        "then": { "const": { "value": "Depresión leve", "type": "string" } }
      },
      {
        "when": { "expression": { "type": "comparison", "operator": "<",
                  "args": [ { "subject": { "entity": "form", "property": "result.scoring" } },
                            { "const": { "value": 15, "type": "number" } } ],
                  "output": { "type": "boolean" } } },
        "then": { "const": { "value": "Depresión moderada", "type": "string" } }
      },
      {
        "when": { "expression": { "type": "comparison", "operator": "<",
                  "args": [ { "subject": { "entity": "form", "property": "result.scoring" } },
                            { "const": { "value": 20, "type": "number" } } ],
                  "output": { "type": "boolean" } } },
        "then": { "const": { "value": "Depresión moderadamente severa", "type": "string" } }
      },
      {
        "when": { "expression": { "type": "comparison", "operator": "<=",
                  "args": [ { "subject": { "entity": "form", "property": "result.scoring" } },
                            { "const": { "value": 27, "type": "number" } } ],
                  "output": { "type": "boolean" } } },
        "then": { "const": { "value": "Depresión severa", "type": "string" } }
      }
    ],
    "default": { "const": { "value": "Puntuación fuera de rango", "type": "string" } },
    "output": { "type": "string" },
    "args": []
  }
}
