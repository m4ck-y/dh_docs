{
  /* Ejemplos de question.expression: la receta de un valor AUTOCALCULADO.
     Es UNA expresion (raiz SIN wrapper = un operador), como condition. La
     pregunta es de solo lectura (el usuario no la responde); su valor se
     recalcula en vivo y se persiste como answer con source=CALCULATED al
     enviar (snapshot).
     Contrato (C19 / ADR 042): text obligatorio, type compatible con el output,
     SIN config, y NUNCA el resultado global del instrumento (eso va en
     form.expression.scoring). Ver ../README.md (Preguntas autocalculadas). */

  /* Ej 1: "IMC" = person.weight / person.height^2. Derivado externo (person). */
  "imc": {
    "type": "math",
    "operator": "/",
    "args": [
      { "subject": { "entity": "person", "property": "weight" } },
      {
        "expression": {
          "type": "math",
          "operator": "^",
          "args": [
            { "subject": { "entity": "person", "property": "height" } },
            { "const": { "value": 2, "type": "number" } }
          ],
          "output": { "type": "number" }
        }
      }
    ],
    "output": { "type": "number" }
  },

  /* Ej 2: "Diferencia" entre dos items (referencia a otras preguntas, PERMITIDO).
     No es el resultado global: es un derivado acotado entre dos respuestas. */
  "diferencia": {
    "type": "math",
    "operator": "-",
    "args": [
      { "subject": { "entity": "question", "property": "value", "selector": { "id": 3 } } },
      { "subject": { "entity": "question", "property": "value", "selector": { "id": 7 } } }
    ],
    "output": { "type": "number" }
  }

  /* PROHIBIDO como pregunta: el "total del instrumento" (suma de todas las
     respuestas) va en form.expression.scoring, no en question.expression.
     Duplicarlo aqui duplicaria el scoring y, con selector {all}, provocaria
     doble conteo. Ver ../README.md (Contrato de la pregunta calculada, C19). */
}
